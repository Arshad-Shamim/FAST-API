dbHost=localhost
dbPort=5432
user=postgres
database=leave_manager
password=YOUR_POSTGRES_PASSWORD

# Keep "hello users" only if you need compatibility with existing Node JWTs.
# Better: use a new strong secret and log in again after migration.
JWT_SECRET=hello users

# Local PostgreSQL: false. Hosted PostgreSQL: usually true.
DB_SSL=false

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=Leave-Portal-Users

FRONTEND_ORIGIN=http://localhost:5173
